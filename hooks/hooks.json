{
  "description": "Spree safety hooks — block destructive database commands and force-pushes to main/master, warn on hardcoded secrets in edits.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block_destructive_db.sh\""
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/warn_on_secrets.sh\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ]
  }
}
